# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database & Authentication
MONGO_URI=
JWT_SECRET=
JWT_EXPIRE=30d

# Optional Elasticsearch search index. false keeps the API disconnected, as it is today.
# Local Docker binds to 127.0.0.1 with security disabled, so the API key stays empty.
# A hosted cluster needs its HTTPS node URL and an API key. Never commit backend/.env.
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_NODE=http://127.0.0.1:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=scholarships

# Matching worker pool. Size defaults to min(4, available CPUs). Queue defaults to 100.
# Set these before the process starts. A one-vCPU host therefore uses one worker unless overridden.
# MATCHING_WORKER_POOL_SIZE=4
# MATCHING_WORKER_MAX_QUEUE=100

# SMTP_* is used only by the manual backend/tests/test-email.js script.
# Account emails are sent by Resend in src/utils/emailService.js.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=iskolarmatch@gmail.com
SMTP_PASSWORD=

# Standard Email Fallbacks & Admin Notifications
EMAIL_USER=
EMAIL_PASS=
# Address on a domain verified in the Resend dashboard, for example:
# IskolarMatch <noreply@your-domain>
# An empty value falls back to onboarding@resend.dev, which is often spam-filtered.
# Publish the SPF and DKIM records Resend shows for that domain, plus DMARC.
FROM_EMAIL=
FROM_NAME=
ADMIN_EMAIL=

# Optional Transactional Email Backup
RESEND_API_KEY=r

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
